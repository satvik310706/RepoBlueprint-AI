# ==============================================================================
# RepoBlueprint AI — Environment Configuration Example
# Copy this file to '.env' and customize values for local development or production.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AI Engine Configuration
# ------------------------------------------------------------------------------
# Default AI provider to select on startup: 'ollama' | 'gemini' | 'demo'
VITE_DEFAULT_PROVIDER=ollama

# Google Gemini API Configuration (Get free key: https://aistudio.google.com/app/apikey)
# Leave blank if you prefer users to enter their own key in the UI
VITE_GEMINI_API_KEY=
VITE_GEMINI_MODEL=gemini-2.5-flash

# Local Offline Ollama Configuration
VITE_OLLAMA_URL=http://localhost:11434
VITE_OLLAMA_MODEL=llama3.2:3b

# ------------------------------------------------------------------------------
# 2. Cloudinary Media Asset Vault & CDN (For Whiteboard & Photo Sync)
# ------------------------------------------------------------------------------
VITE_CLOUDINARY_CLOUD_NAME=bgumuh2m
VITE_CLOUDINARY_UPLOAD_PRESET=repo_blueprint
VITE_CLOUDINARY_API_KEY=749746485129813
VITE_CLOUDINARY_API_SECRET=vHBLCLMbDsdWOLR1Us4asZCGmVw
VITE_CLOUDINARY_FOLDER=repo-blueprint

# ------------------------------------------------------------------------------
# 3. Docker & Production Deployment Settings
# ------------------------------------------------------------------------------
# Port to expose when running via 'docker compose up' (default: 80)
PORT=80

# Host and port for the local Ollama daemon from inside the Docker container
# On Docker Desktop (Windows/macOS/Linux), 'host.docker.internal:11434' reaches the host machine.
OLLAMA_HOST=host.docker.internal:11434
